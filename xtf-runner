#!/usr/bin/env python3
"""Compatibility wrapper for the importable xtf-runner implementation."""

import sys

from xtf.runner.cli import RunnerError, main

if __name__ == "__main__":
    try:
        sys.exit(main())
    except RunnerError as e:
        print("Error:", e, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(1)
